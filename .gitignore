# Local secrets and machine-specific config
.env
.env.*
!.env.example
UBUNTU_TEST_SECRET.txt
.proxy/

# Python
__pycache__/
.pycache/
*.py[cod]
.pytest_cache/
.venv/
.venv_setup_test/

# Node / Vite
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/dist/

# Build and release artifacts
dist/
static-workbench/
backups/
outputs/
*.zip
*.tar
*.tar.gz
*.tgz
*.sha256

# Runtime databases and generated media/workspace data
storage/*
!storage/.gitkeep
!storage/classification_cache/
storage/classification_cache/*
!storage/classification_cache/.gitkeep
!storage/workspace/
storage/workspace/*
!storage/workspace/.gitkeep

# Nested project layout
ecommerce-ops-platform/ops-workbench/frontend/node_modules/
ecommerce-ops-platform/ops-workbench/frontend/*.tsbuildinfo
ecommerce-ops-platform/ops-workbench/frontend/vite.config.js
ecommerce-ops-platform/ops-workbench/frontend/vite.config.d.ts
ecommerce-ops-platform/ops-workbench/static-workbench/
ecommerce-ops-platform/ops-workbench/backups/
ecommerce-ops-platform/ops-workbench/outputs/
ecommerce-ops-platform/ops-workbench-runtime/
ecommerce-ops-platform/ops-workbench/storage/

# Local logs and OS/editor noise
*.log
screenlog.*
.DS_Store
Thumbs.db
